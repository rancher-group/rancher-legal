 "mailer_subjects_confirmation": "Confirm your email for Rancher Legal",
 "mailer_templates_confirmation_content": "<!DOCTYPE html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light dark\"><meta name=\"supported-color-schemes\" content=\"light dark\">\n<title>Confirm your email address</title><style>\n:root { color-scheme: light dark; supported-color-schemes: light dark; }\nbody, .bg { background:#f7f6ee !important; }\n@media (prefers-color-scheme: dark) {\n  body, .bg { background:#1c1b19 !important; }\n  .card { background:#262420 !important; border-color:#494238 !important; }\n  .text, .text p, .text h1, .code, .wordmark { color:#f7f6ee !important; }\n  .muted, .muted p, .muted a { color:#b8b1a5 !important; }\n  .btn { background:#f7f6ee !important; }\n  .btn a { color:#193e34 !important; }\n  .rule { border-color:#494238 !important; }\n}\n[data-ogsc] .card { background:#262420 !important; border-color:#494238 !important; }\n[data-ogsc] .text, [data-ogsc] .text p, [data-ogsc] .text h1, [data-ogsc] .code, [data-ogsc] .wordmark { color:#f7f6ee !important; }\n[data-ogsc] .muted, [data-ogsc] .muted p, [data-ogsc] .muted a { color:#b8b1a5 !important; }\n[data-ogsb] .btn { background:#f7f6ee !important; }\n[data-ogsc] .btn a { color:#193e34 !important; }\na { color:inherit; }\n</style></head>\n<body class=\"body\" style=\"margin:0;padding:0;background:#f7f6ee;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" class=\"bg\" style=\"background:#f7f6ee;\"><tr><td align=\"center\" style=\"padding:32px 16px;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:520px;\">\n<tr><td style=\"padding:0 4px 20px;\"><span class=\"wordmark\" style=\"font-family:Arial,Helvetica,sans-serif;font-size:26px;font-weight:700;letter-spacing:-1.2px;color:#193e34;\">rancher</span><span class=\"wordmark\" style=\"font-family:Arial,Helvetica,sans-serif;font-size:15px;font-weight:400;color:#193e34;padding-left:8px;\">Legal</span></td></tr>\n<tr><td class=\"card text\" style=\"background:#fffef7;border:1px solid #d9dfd3;border-radius:12px;padding:32px 28px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#193e34;\">\n<h1 style=\"margin:0 0 16px;font-size:22px;line-height:1.3;font-weight:700;color:#193e34;\">Confirm your email address</h1>\n<p>Confirm this email address to finish creating your Rancher Legal account.</p>\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:28px 0 8px;\"><tr><td class=\"btn\" style=\"background:#193e34;border-radius:8px;\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:13px 24px;font-family:Arial,Helvetica,sans-serif;font-size:15px;font-weight:700;color:#fffef7;text-decoration:none;border-radius:8px;\">Confirm email address</a></td></tr></table>\n<div class=\"muted\" style=\"color:#536059;\"><p style=\"margin:16px 0 0;font-size:13px;line-height:1.5;\">If the button doesn't work, copy this link into your browser:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#536059;word-break:break-all;\">{{ .ConfirmationURL }}</a></p>\n<p class=\"rule\" style=\"margin:24px 0 0;padding-top:16px;border-top:1px solid #d9dfd3;font-size:13px;line-height:1.5;color:#536059;\">If you didn't sign up for Rancher Legal, you can ignore this email.</p></div>\n</td></tr>\n<tr><td class=\"muted\" style=\"padding:20px 4px 0;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:1.5;color:#536059;\">Rancher Legal &middot; <a href=\"https://legal.gorancher.com\" style=\"color:#536059;\">legal.gorancher.com</a></td></tr>\n</table></td></tr></table></body></html>",
 "mailer_subjects_recovery": "Reset your Rancher Legal password",
 "mailer_templates_recovery_content": "<!DOCTYPE html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light dark\"><meta name=\"supported-color-schemes\" content=\"light dark\">\n<title>Reset your password</title><style>\n:root { color-scheme: light dark; supported-color-schemes: light dark; }\nbody, .bg { background:#f7f6ee !important; }\n@media (prefers-color-scheme: dark) {\n  body, .bg { background:#1c1b19 !important; }\n  .card { background:#262420 !important; border-color:#494238 !important; }\n  .text, .text p, .text h1, .code, .wordmark { color:#f7f6ee !important; }\n  .muted, .muted p, .muted a { color:#b8b1a5 !important; }\n  .btn { background:#f7f6ee !important; }\n  .btn a { color:#193e34 !important; }\n  .rule { border-color:#494238 !important; }\n}\n[data-ogsc] .card { background:#262420 !important; border-color:#494238 !important; }\n[data-ogsc] .text, [data-ogsc] .text p, [data-ogsc] .text h1, [data-ogsc] .code, [data-ogsc] .wordmark { color:#f7f6ee !important; }\n[data-ogsc] .muted, [data-ogsc] .muted p, [data-ogsc] .muted a { color:#b8b1a5 !important; }\n[data-ogsb] .btn { background:#f7f6ee !important; }\n[data-ogsc] .btn a { color:#193e34 !important; }\na { color:inherit; }\n</style></head>\n<body class=\"body\" style=\"margin:0;padding:0;background:#f7f6ee;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" class=\"bg\" style=\"background:#f7f6ee;\"><tr><td align=\"center\" style=\"padding:32px 16px;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:520px;\">\n<tr><td style=\"padding:0 4px 20px;\"><span class=\"wordmark\" style=\"font-family:Arial,Helvetica,sans-serif;font-size:26px;font-weight:700;letter-spacing:-1.2px;color:#193e34;\">rancher</span><span class=\"wordmark\" style=\"font-family:Arial,Helvetica,sans-serif;font-size:15px;font-weight:400;color:#193e34;padding-left:8px;\">Legal</span></td></tr>\n<tr><td class=\"card text\" style=\"background:#fffef7;border:1px solid #d9dfd3;border-radius:12px;padding:32px 28px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#193e34;\">\n<h1 style=\"margin:0 0 16px;font-size:22px;line-height:1.3;font-weight:700;color:#193e34;\">Reset your password</h1>\n<p>We received a request to reset your Rancher Legal password. Use the button below to choose a new one.</p>\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:28px 0 8px;\"><tr><td class=\"btn\" style=\"background:#193e34;border-radius:8px;\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:13px 24px;font-family:Arial,Helvetica,sans-serif;font-size:15px;font-weight:700;color:#fffef7;text-decoration:none;border-radius:8px;\">Reset password</a></td></tr></table>\n<div class=\"muted\" style=\"color:#536059;\"><p style=\"margin:16px 0 0;font-size:13px;line-height:1.5;\">If the button doesn't work, copy this link into your browser:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#536059;word-break:break-all;\">{{ .ConfirmationURL }}</a></p>\n<p class=\"rule\" style=\"margin:24px 0 0;padding-top:16px;border-top:1px solid #d9dfd3;font-size:13px;line-height:1.5;color:#536059;\">If you didn't request this, you can ignore this email. Your password won't change.</p></div>\n</td></tr>\n<tr><td class=\"muted\" style=\"padding:20px 4px 0;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:1.5;color:#536059;\">Rancher Legal &middot; <a href=\"https://legal.gorancher.com\" style=\"color:#536059;\">legal.gorancher.com</a></td></tr>\n</table></td></tr></table></body></html>",
